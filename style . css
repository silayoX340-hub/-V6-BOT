* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', 'Poppins', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    background: linear-gradient(135deg, #0a0f1e 0%, #0a1a1a 100%);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    position: relative;
}

/* Background pattern */
body::before {
    content: "SILAYOX";
    font-size: 120px;
    position: fixed;
    bottom: -30px;
    right: -50px;
    opacity: 0.02;
    font-weight: bold;
    pointer-events: none;
    white-space: nowrap;
}

.container {
    width: 100%;
    max-width: 550px;
    z-index: 1;
}

.main-card {
    background: rgba(10, 20, 25, 0.85);
    backdrop-filter: blur(16px);
    border-radius: 48px;
    padding: 2rem;
    border: 1px solid rgba(0, 255, 200, 0.2);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0, 255, 200, 0.1) inset;
}

/* Header */
.header {
    text-align: center;
    margin-bottom: 2rem;
}

.logo {
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #00ffcc, #00cc88);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -1px;
}

.logo span {
    background: linear-gradient(135deg, #ffaa44, #ff6644);
    -webkit-background-clip: text;
    background-clip: text;
}

.tagline {
    color: #66ccaa;
    font-size: 0.75rem;
    margin-top: 5px;
    letter-spacing: 2px;
}

/* Method Tabs */
.method-tabs {
    display: flex;
    gap: 12px;
    background: #0a1217;
    padding: 6px;
    border-radius: 60px;
    margin: 20px 0;
}

.method-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    border: none;
    background: transparent;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.3s;
    color: #88aacc;
}

.method-btn.active {
    background: linear-gradient(135deg, #00cc88, #009966);
    color: #000;
    box-shadow: 0 2px 10px rgba(0, 200, 100, 0.3);
}

/* Method Areas */
.method-area {
    display: none;
    margin: 20px 0;
    text-align: center;
}

.method-area.active {
    display: block;
}

.qr-box {
    display: flex;
    justify-content: center;
    margin: 15px 0;
}

.qr-placeholder {
    width: 220px;
    height: 220px;
    background: #0a1217;
    border-radius: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 2px dashed #2a4a4a;
    color: #5599aa;
}

.spinner {
    width: 40px;
    height: 40px;
    border: 3px solid #2a4a4a;
    border-top-color: #00ffcc;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

#qr-canvas {
    width: 220px;
    height: 220px;
    background: white;
    border-radius: 28px;
    padding: 10px;
}

.input-wrapper {
    margin: 15px 0;
}

.input-wrapper input {
    width: 100%;
    padding: 14px 18px;
    background: #0a1217;
    border: 1px solid #2a4a4a;
    border-radius: 34px;
    color: #ccffdd;
    font-size: 1rem;
    text-align: center;
    outline: none;
}

.input-wrapper input:focus {
    border-color: #00ffcc;
    box-shadow: 0 0 10px rgba(0, 255, 200, 0.2);
}

.input-wrapper small {
    display: block;
    color: #5599aa;
    font-size: 0.7rem;
    margin-top: 8px;
}

.hint {
    font-size: 0.7rem;
    color: #5599aa;
    margin-top: 10px;
}

/* Session Card - IMPORTANT */
.session-card {
    background: #051012;
    border-radius: 28px;
    padding: 1rem;
    margin: 20px 0;
    border: 1px solid #1a4a4a;
}

.session-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    font-weight: 600;
    color: #00ffcc;
    margin-bottom: 10px;
    text-transform: uppercase;
}

.session-value {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    background: #000000;
    padding: 12px;
    border-radius: 20px;
}

.session-value code {
    font-size: 0.7rem;
    word-break: break-all;
    color: #00ffcc;
    font-family: monospace;
    flex: 1;
}

.copy-btn {
    background: #1a3a3a;
    border: none;
    padding: 6px 14px;
    border-radius: 40px;
    color: #00ffcc;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.copy-btn:hover:not(:disabled) {
    background: #00cc88;
    color: #000;
}

.copy-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.session-warning {
    font-size: 0.65rem;
    color: #ffaa66;
    margin-top: 10px;
    text-align: center;
}

/* Connect Button */
.connect-btn {
    width: 100%;
    padding: 16px;
    background: linear-gradient(135deg, #00cc88, #009966);
    border: none;
    border-radius: 40px;
    color: #000;
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
    margin: 10px 0;
}

.connect-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 200, 100, 0.3);
}

/* Status Bar */
.status-bar {
    background: rgba(0, 0, 0, 0.5);
    border-radius: 40px;
    padding: 12px;
    text-align: center;
    font-size: 0.75rem;
    color: #88ccaa;
    margin: 15px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

/* YouTube Link */
.youtube-link {
    margin: 15px 0;
    text-align: center;
}

.youtube-link a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 0, 0, 0.1);
    padding: 10px 20px;
    border-radius: 40px;
    text-decoration: none;
    color: #ff7777;
    font-weight: 600;
    font-size: 0.8rem;
    transition: all 0.3s;
    border: 1px solid rgba(255, 0, 0, 0.3);
}

.youtube-link a:hover {
    background: rgba(255, 0, 0, 0.2);
    transform: scale(1.02);
}

/* Footer */
footer {
    text-align: center;
    font-size: 0.6rem;
    color: #336666;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #1a3a3a;
}

/* Responsive */
@media (max-width: 480px) {
    .main-card {
        padding: 1.3rem;
    }
    
    .logo {
        font-size: 1.5rem;
    }
}
